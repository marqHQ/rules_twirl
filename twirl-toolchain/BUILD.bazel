load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//:versions.bzl", "scala_2_13_version", "scala_3_version")
load(":create-toolchain.bzl", "create_twirl_toolchain")

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

create_twirl_toolchain(
    name = "twirl-3",
    scala_version = scala_3_version,
    twirl_compiler = "//twirl-compiler-cli:twirl-compiler-cli-3",
)

create_twirl_toolchain(
    name = "twirl-2-13",
    scala_version = scala_2_13_version,
    twirl_compiler = "//twirl-compiler-cli:twirl-compiler-cli-2-13",
)

# For Play 2.7 consumers to register ahead of twirl-2-13; it matches every 2.13 target.
create_twirl_toolchain(
    name = "twirl-2-13-play-2-7",
    scala_version = scala_2_13_version,
    twirl_compiler = "//twirl-compiler-cli:twirl-compiler-cli-2-13-play-2-7",
)

# Registered by this module so its tests can select the Play 2.7 compiler with
# scala_version = "play-2-7_2.13" without shadowing twirl-2-13.
create_twirl_toolchain(
    name = "twirl-2-13-play-2-7-prefixed",
    prefix = "play-2-7",
    scala_version = scala_2_13_version,
    twirl_compiler = "//twirl-compiler-cli:twirl-compiler-cli-2-13-play-2-7",
)

bzl_library(
    name = "bzl",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
    deps = ["@rules_scala_annex//rules:scala-rules"],
)
